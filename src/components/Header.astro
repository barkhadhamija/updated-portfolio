---
import { person } from '../data/site';

const links = [
  { n: '01', label: 'Things I’ve made', href: '/#work' },
  { n: '02', label: 'About', href: '/#about' },
  { n: '03', label: 'On my desk', href: '/#desk' },
  { n: '04', label: 'Say hi', href: '/#hi' },
];
---

<header class="site-header">
  <div class="wrap header-inner">
    <a href="/" class="brand"><span class="brand-mark" aria-hidden="true"></span>Barkha Dhamija</a>
    <nav class="nav" aria-label="Main">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <div class="header-actions">
      <span class="mono header-clock"><span class="live-dot" aria-hidden="true"></span>Delhi <span data-clock>--:--</span></span>
      <button type="button" class="theme-toggle" data-theme-toggle data-cursor="switch" aria-label="Switch between day and night colours">
        <span class="theme-track" aria-hidden="true">
          <svg class="theme-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
          <svg class="theme-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"></path></svg>
          <span class="theme-knob"></span>
        </span>
        <span class="mono theme-name" data-theme-name>Day</span>
      </button>
      <a href={person.resume} class="resume-link" data-cursor="download" target="_blank" rel="noopener">Resume <span aria-hidden="true">↗</span></a>
      <button class="mono menu-btn" popovertarget="menu">Menu</button>
    </div>
  </div>
</header>

<div id="menu" class="menu-overlay" popover>
  <button class="mono menu-close" popovertarget="menu" popovertargetaction="hide">Close</button>
  <nav aria-label="Menu">
    <ol class="menu-list">
      {
        links.map((l) => (
          <li>
            <a href={l.href}>
              <span class="mono">{l.n}</span>
              {l.label}
            </a>
          </li>
        ))
      }
      <li>
        <a href={person.resume} target="_blank" rel="noopener">
          <span class="mono">05</span>
          Resume ↗
        </a>
      </li>
    </ol>
  </nav>
</div>
