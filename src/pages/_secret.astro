---
import Base from '../layouts/Base.astro';
---

<Base title="The back room — Barkha Dhamija" noindex>
  <article class="container case">
    <a href="/" class="btn-text back">← Back to the front</a>
    <p class="label" data-reveal>Secret page</p>
    <h1 class="display" data-split>You found the back room.</h1>
    <p class="case-summary" data-reveal>[One line welcoming whoever clicked that button three times.]</p>

    <section class="case-block" data-reveal>
      <h2 class="label">Bloopers</h2>
      <p>[Builds that broke in funny ways, the worst bug you ever shipped, the commit message you regret.]</p>
    </section>
    <section class="case-block" data-reveal>
      <h2 class="label">On repeat</h2>
      <ol class="plain-list">
        <li>[Song — Artist]</li>
        <li>[Song — Artist]</li>
        <li>[Song — Artist]</li>
        <li>[Song — Artist]</li>
        <li>[Song — Artist]</li>
      </ol>
    </section>
    <section class="case-block" data-reveal>
      <h2 class="label">Unfiltered opinions</h2>
      <p>[Tabs or spaces. Dark mode or light. How you take your coffee.]</p>
    </section>
  </article>
</Base>
