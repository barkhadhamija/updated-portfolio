---
// Fonts: Bricolage Grotesque (headlines + body), Instrument Serif italic (accent words), Geist Mono (labels).
import '@fontsource-variable/bricolage-grotesque/opsz.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Terminal from '../components/Terminal.astro';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = 'Barkha Dhamija — Developer & Designer',
  description = 'Developer and designer in New Delhi. Flutter apps, React and Next.js sites, Go backends and design systems.',
  noindex = false,
} = Astro.props;

// absolute URLs for link previews; they come from `site` in astro.config.mjs
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Barkha Dhamija" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Hi, I’m Barkha. Developer and designer in New Delhi." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#FAFAF7" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // Runs before paint: Day / Night theme and the motion preference.
      (function () {
        var d = document.documentElement;
        function get(k) { try { return localStorage.getItem(k); } catch (e) { return null; } }
        var t = get('theme');
        if (t !== 'day' && t !== 'night') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'night' : 'day';
        d.dataset.theme = t;
        var m = get('motion');
        var reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
        d.classList.add(m === 'off' || (m !== 'on' && reduced) ? 'still' : 'motion');
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <Terminal />
    <div class="cursor" aria-hidden="true"><span class="cursor-dot"></span><span class="cursor-label mono" data-cursor-label></span></div>
    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
